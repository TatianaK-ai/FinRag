# --- OpenAI (embeddings + generation) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional: point at Nebius or any OpenAI-compatible gateway
# OPENAI_BASE_URL=https://api.studio.nebius.ai/v1

# --- Pinecone (dense vector store) ---
# https://app.pinecone.io -> your project -> API Keys
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=finrag-py

# --- SEC EDGAR ---
# EDGAR rejects requests without a User-Agent identifying a real contact.
SEC_USER_AGENT=Your Name your.email@example.com

# --- Server guards ---
# Without APP_API_KEY the server binds to 127.0.0.1 only and refuses off-box
# connections: an open /api/ask spends your OpenAI credit on every request.
APP_API_KEY=choose-a-long-random-secret
# BIND_HOST=0.0.0.0
# RATE_LIMIT_PER_MINUTE=20     # per client
# RATE_LIMIT_PER_DAY=500       # global, bounds total API spend

# --- Optional overrides ---
# GEN_MODEL=gpt-4.1-mini
# JUDGE_MODEL=gpt-4.1
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536
# VECTOR_BACKEND=local        # skip Pinecone entirely; brute-force local vectors

# --- Evaluation ---
# The gates are model calls and do not settle on one answer; a single run has
# been wide enough to change conclusions. 3 repetitions is the working minimum.
# EVAL_REPEATS=3

# --- Tests ---
# The offline suite sets these itself; listed so the isolation is visible.
# DATA_DIR=data-test            # derived artefacts only; raw filings stay shared
